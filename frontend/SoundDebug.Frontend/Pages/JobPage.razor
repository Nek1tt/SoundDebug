@page "/job/{jobId:int}"
@using SoundDebug.Frontend.Components
@using SoundDebug.Frontend.Models
@inject IJSRuntime JS
@* @inject UploadService UploadService *@
@inject ReportService ReportService

<div class="main-layout">
    <Navbar/>
    <div class="bg">
        <div class="blob"></div>
        <div class="blob"></div>
    </div>
    @* @if (job is null || job.status == "pending")
    {
        <div class="glass-loader">
            <div class="spinner"></div>
            @* <div class="text">В обработке...</div> *@
        @* </div>
    } *@
    @* else *@
    @* {  *@
        <h1>Номер задачи: @jobId</h1>
    @* } *@
</div>

@code {
    [Parameter]
    public int jobId { get; set; }

    public JobModel? job; 

    protected override async Task OnInitializedAsync()
    {
        @* job = await UploadService.GetJob(jobId); *@

        @* await JS.InvokeVoidAsync("console.log", "Задача:", job); *@

        while (true)
        {
            var report = await ReportService.GetReportAsync(jobId);

            if (report != null)
            {
                await JS.InvokeVoidAsync("console.log", report.Metrics);
                break;
            }

            await Task.Delay(2000);
        }
    }
}