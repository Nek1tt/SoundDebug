@page "/profile"
@using SoundDebug.Frontend.Components
@using SoundDebug.Frontend.Models
@inject IJSRuntime JS
@inject AuthService AuthService
@inject UploadService UploadService

<PageTitle>SoundDebug</PageTitle>

<div class="main-layout">
    <div class="bg">
        <div class="blob"></div>
        <div class="blob"></div>
    </div>
    <Navbar/>
    <div>
        @if (!isLoaded)
        {
            <p style="color:white;">Загрузка...</p>
        }
        else
        {
            <span class="user-name">Привет, @Username</span>
        }
    </div>
    <div class="jobs-list">
        <h1 style="color: white; text-align: center;">Список задач</h1>
        <div class="horizontal-line"></div>
        @if (userJobs == null)
        {
            <p style="color:white;">Загрузка...</p>
        }
        else
        {
            @foreach (var job in userJobs)
            {
                <Job Data="job" />
            }
        }
    </div>
</div>

@code {
    private string? Email;
    private string? Username;
    private bool isLoaded = false;

    private List<JobModel?> userJobs;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        UserModel? user = await AuthService.GetMeAsync();

        @* await JS.InvokeVoidAsync("console.log", "Пользователь:", user); *@

        if (user != null)
        {
            Email = user.Email;
        }

        userJobs = await UploadService.GetJobs();

        Username = Email?.Split('@')[0];
        isLoaded = true;
    }
    
}

