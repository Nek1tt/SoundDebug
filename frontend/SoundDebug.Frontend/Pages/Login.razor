@page "/login"

@using SoundDebug.Frontend
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>SoundDebug</PageTitle>

<div class="main-layout">
    <div class="bg">
        <div class="blob"></div>
        <div class="blob"></div>
    </div>
    <div class="form">
        <div class="greeting">
            <a href="/" class="logo">SoundDebug</a>
        </div>
        <div class="form-input">
            <label for="email">Почта</label>
            <input id="email" placeholder="моеимя@мояпочта.ру" @bind="email"/>
            <label for="password">Пароль</label>
            <input id="password" type="password" placeholder="мойпароль" @bind="password"/>
        </div>

        <button @onclick="HandleSubmit" class="sign-button">
            @(isRegisterMode ? "Зарегистрироваться" : "Войти")
        </button>

        <div style="margin-top:10px;">
            <button class="change-button" @onclick="ToggleMode">
                @(isRegisterMode 
                    ? "Уже есть аккаунт? Войти" 
                    : "Нет аккаунта? Зарегистрироваться")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <p style="color:red">@error</p>
        }
    </div>
</div>

@code {
    private string email = ""; 
    private string password = "";
    private string error = "";
    private bool isRegisterMode = false;
    @* private bool isLoading = false; *@

    private async Task HandleSubmit()
    {
        error = "";
        @* isLoading = true; *@

        try
        {
            bool success;

            if (isRegisterMode)
            {
                // регистрация
                var response = await AuthService.RegisterAsync(email, password);
                if (!response)
                {
                    error = "Ошибка регистрации";
                    return;
                }

                // после успешной регистрации — сразу логинимся
                success = await AuthService.LoginAsync(email, password);
            }
            else
            {
                // логин
                success = await AuthService.LoginAsync(email, password);
            }

            if (success)
            {
                Navigation.NavigateTo("/profile");
            }
            else
            {
                error = "Неверная почта или пароль";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            @* isLoading = false; *@
        }
    }

    void ToggleMode()
    {
        isRegisterMode = !isRegisterMode;
        error = "";
    }
}