@page "/input"
@using SoundDebug.Frontend.Components
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>SoundDebug</PageTitle>

<div class="main-layout">
    <Navbar/>
    <div class="bg">
        <div class="blob"></div>
        <div class="blob"></div>
    </div>
    <div class="input-form">
        <DragNDrop H1Text="1 Загрузите вашу запись" FilesSelected="HandleTrack"></DragNDrop>
        <GenreSelect GenreSelectedChanged="HandleGenre"></GenreSelect>
        <DragNDrop H1Text="3 Загрузите ваши референсы" Type="multiple" FilesSelected="HandleReferences"></DragNDrop>
        <button @onclick="CreateJson" class="upload-button">
            Отправить
        </button>
    </div>
</div>

@code {
    private List<IBrowserFile> trackFiles = new();
    private List<IBrowserFile> referenceFiles = new();
    private string genre = string.Empty;

    private async Task HandleTrack(IBrowserFile[] files)
    {
        trackFiles = files.ToList();
        await JS.InvokeVoidAsync("console.log", "Выбранные записи:", files.Select(f => f.Name).ToArray());
    }

    private async Task HandleReferences(IBrowserFile[] files)
    {
        referenceFiles = files.ToList();
        await JS.InvokeVoidAsync("console.log", "Выбранные записи:", files.Select(f => f.Name).ToArray());
    }

    private async Task HandleGenre(string selectedGenre)
    {
        genre = selectedGenre;
        await JS.InvokeVoidAsync("console.log", "Выбранный жанр:", genre);
    }

    public class UploadRequest
    {
        public string Genre { get; set; } = string.Empty;
        public List<string> Tracks { get; set; } = new();
        public List<string> References { get; set; } = new();
    }

    private async Task CreateJson()
    {
        var request = new UploadRequest
        {
            Genre = genre,
            Tracks = trackFiles.Select(f => f.Name).ToList(),
            References = referenceFiles.Select(f => f.Name).ToList()
        };

        var json = System.Text.Json.JsonSerializer.Serialize(request, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });

        Navigation.NavigateTo("/loading");

        await JS.InvokeVoidAsync("console.log", json);
    }
}
