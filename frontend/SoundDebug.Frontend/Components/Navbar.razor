@inject NavigationManager Navigation
@inject AuthService AuthService

<div class="navbar">
    <a href="/" class="logo">SoundDebug</a>
    <div class="central-block">
        <a href="/input" class="central-button">Попробовать</a>
        <span class="central-button">Примеры</span>
    </div>
    <div class="right-block">
        @if (AuthService.IsAuthenticated)
        {
            <button @onclick="LogOut" class="right-button">Выйти</button>
        }
        else
        {
            <button @onclick="LogIn" class="right-button">Войти</button>
        }
        <span class="right-button">Контакты</span>
    </div>
</div>

@code {
    private bool Authorized = true;
    private void LogIn() {
        Navigation.NavigateTo("/login");
    }

    private async Task LogOut() {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}