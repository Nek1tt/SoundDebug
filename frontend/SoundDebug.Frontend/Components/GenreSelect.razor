<div class='main-layout'>
    <h1 style="color: white;">2 Выберите жанр</h1>

    <InputSelect class="form-select" TValue="string" @bind-Value="CurrentGenre">
        <option value="">Выберите жанр</option>
        <option value="modern-pop">Современный поп</option>
        <option value="hip-hop">Хип-хоп</option>
        <option value="techno">Техно</option>
        <option value="lo-fi">Lo-Fi</option>
        <option value="electronic">Electronic</option>
    </InputSelect>
</div>

@code {
    [Parameter] public string GenreSelected { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> GenreSelectedChanged { get; set; }

    private string CurrentGenre
    {
        get => GenreSelected;
        set
        {
            GenreSelected = value;
            GenreSelectedChanged.InvokeAsync(value);
        }
    }
}
