@using SoundDebug.Frontend.Models

<div class="main-layout">
    <div class="job-number">
        <label for="job">Задача</label>
        <a href="@($"/job/{Data.id}")" id="job">@Data.id</a>
    </div>
    <div class="status">
        <label for="status">Статус</label>
        <h1 id="status">@Data.status</h1>
    </div>
    @if (Data.status is "done" or "failed")
    {
        <button class="delete-button" @onclick="() => DeleteRequested.InvokeAsync(Data.id)">Удалить</button>
    }
</div>


@code {
    [Parameter] public JobModel Data { get; set; } = default!;
    [Parameter] public EventCallback<int> DeleteRequested { get; set; }
}
