@using SoundDebug.Frontend.Models

<div class="main-layout">
    <div class="job-number">
        <label for="job">Задача</label>
        <a href="@($"/job/{Data.id}")" id="job">@Data.id</a>
    </div>
    <div class="status">
        <label for="status">Статус</label>
        <h1 id="status">@Data.status</h1>
    </div>
</div>


@code {
    [Parameter] public JobModel Data { get; set; } = default!;
}