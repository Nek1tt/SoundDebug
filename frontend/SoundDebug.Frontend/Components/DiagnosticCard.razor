@using SoundDebug.Frontend.Models

<section class="diagnostic-card @Finding.Severity">
    <div class="diagnostic-meta">
        <span class="class-tag @Finding.Classification.ToLowerInvariant()">@ClassLabel(Finding.Classification)</span>
        <span class="priority-tag">Приоритет: @PriorityLabel(Finding.Priority)</span>
        <span class="reliability-tag">Надёжность: @ReliabilityLabel(Finding.Reliability)</span>
    </div>
    <h3>@Finding.Title</h3>
    <DiagnosticSection Title="Что обнаружено" Text="@Finding.WhatDetected" />
    <DiagnosticSection Title="Почему SoundDebug обратил на это внимание" Text="@Finding.WhyAttention" />
    <DiagnosticSection Title="Что это может означать на слух" Text="@Finding.AudibleMeaning" />
    @if (Finding.PossibleCauses.Count > 0)
    {
        <div class="diagnostic-section"><h4>Возможные причины</h4><ul>@foreach (var cause in Finding.PossibleCauses) { <li>@cause</li> }</ul></div>
    }
    @if (Finding.Timestamps.Count > 0)
    {
        <div class="listen-places"><strong>Где проверить:</strong> @string.Join(", ", Finding.Timestamps.Select(TimeLabel))</div>
    }
    <div class="diagnostic-section daw-steps"><h4>Что проверить в DAW</h4><ol>@foreach (var step in Finding.DawCheckSteps) { <li>@step</li> }</ol></div>
    <div class="do-not"><h4>Чего не следует делать автоматически</h4><p>@Finding.DoNotAutomate</p></div>
    @if (!string.IsNullOrWhiteSpace(Finding.ReferenceContext))
    {
        <div class="reference-context"><h4>Контекст референсов</h4><p>@Finding.ReferenceContext</p></div>
    }
    <details class="evidence-details"><summary>Измерения и надёжность</summary><p>@Finding.ReliabilityReason</p><ul>@foreach (var evidence in Finding.Evidence) { <li>@evidence</li> }</ul></details>
</section>

@code {
    [Parameter, EditorRequired] public DiagnosticFinding Finding { get; set; } = new();
    private static string TimeLabel(double seconds) => TimeSpan.FromSeconds(seconds).ToString(@"mm\:ss");
    private static string ClassLabel(string value) => value switch { "FACT" => "Факт", "REFERENCE_DIFFERENCE" => "Отличие от референсов", _ => "Гипотеза" };
    private static string PriorityLabel(string value) => value switch { "CRITICAL" => "критический", "HIGH" => "высокий", "MEDIUM" => "средний", _ => "низкий" };
    private static string ReliabilityLabel(string value) => value switch { "DIRECT" => "прямое измерение", "MEASURED_ESTIMATE" => "измеренная оценка", "HIGH" => "высокая", "MEDIUM" => "средняя", "UNCALIBRATED" => "не откалибрована", _ => "низкая" };
}
