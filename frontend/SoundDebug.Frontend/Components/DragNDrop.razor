<div class="main-layout">
    <div class="first-block">
        <h1 style="color: white;">@H1Text</h1>

        <div class="stroke">
            <div class="string">
                <p style="color: gray;">Переместите файлы или</p>
                <label class="find-button">
                    Найдите
                    <InputFile accept=".wav,.mp3" style="display: none;" OnChange="HandleFileSelected" multiple="@(Type == "multiple")"/>
                </label>
            </div>
        </div>
    </div>

    @if (selectedFiles.Any())
    {
        <ul style="list-style-type: none;">
            @foreach (var file in selectedFiles)
            {
                <li>
                    @file.Name 
                    <small>(@(FormatSize(file.Size)))</small>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string H1Text { get; set; } = "Выберите файлы";
    [Parameter] public string Type { get; set; } = "single";

    [Parameter] public EventCallback<IBrowserFile[]> FilesSelected { get; set; }

    private List<IBrowserFile> selectedFiles = new();

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFiles.Clear();
        selectedFiles.AddRange(e.GetMultipleFiles(20));
        await FilesSelected.InvokeAsync(selectedFiles.ToArray());
    }

    private string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int unit = 0;

        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.##} {units[unit]}";
    }
}