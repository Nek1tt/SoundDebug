@page "/login"
@using blazor_test.Components.Layout
@using blazor_test.Components.UI
@inject NavigationManager Navigation

<PageTitle>SoundDebug</PageTitle>

<div class="main-layout">
    <div class="bg">
        <div class="blob"></div>
        <div class="blob"></div>
    </div>
    <div class="form">
        <div class="greeting">
            <a href="/" class="logo">SoundDebug</a>
        </div>
        <div class="form-input">
            <label for="email">Почта</label>
            <input id="email" placeholder="моеимя@мояпочта.ру"/>
            <label for="password">Пароль</label>
            <input id="password" placeholder="мойпароль"/>
        </div>
        <button @onclick="LogIn" class="sign-button">Войти</button>

    </div>
</div>

@code {
    private async Task LogIn()
    {
        Navigation.NavigateTo("/profile");
    }
}
