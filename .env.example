POSTGRES_USER=sounddebug
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=sounddebug
MINIO_ROOT_USER=sounddebug
MINIO_ROOT_PASSWORD=change-me-minio
JWT_SECRET=change-me-use-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=change-me-use-another-random-secret

# MVP limits
MAX_UPLOAD_MB=50
MAX_AUDIO_DURATION_SEC=900
AUDIO_ML_DEFAULT=false
AUDIO_ML_ENABLED=false
# runtime = deterministic DSP only; audio-ml adds PyTorch + Audiobox Aesthetics
DSP_WORKER_TARGET=runtime
# Optional local checkpoint path inside the worker container
# AUDIO_ML_CHECKPOINT=/models/checkpoint.pt

# Public HTTP port. Put a TLS reverse proxy in front for production.
PUBLIC_PORT=8080
